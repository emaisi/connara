APIHUB_ADDRESS=:8080
APIHUB_DATABASE_URL=postgres://apihub_app:replace-me@127.0.0.1:5432/apihub?sslmode=require
APIHUB_REDIS_ADDR=127.0.0.1:6379
APIHUB_REDIS_PASSWORD=replace-me
APIHUB_REDIS_DB=0
# 使用 scripts/configure.sh 自动生成 bcrypt 哈希；不要在这里保存明文密码。
APIHUB_ADMIN_PASSWORD_HASH=replace-with-bcrypt-password-hash
APIHUB_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
APIHUB_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
APIHUB_WORKSPACE_SLUG=default
APIHUB_WORKSPACE_NAME=APIHub
APIHUB_ADMIN_USER_ID=00000000-0000-0000-0000-000000000002
APIHUB_ADMIN_EMAIL=admin@example.com
APIHUB_PUBLIC_BASE_URL=http://127.0.0.1:8080
APIHUB_ROLE=all
# 仅填写需要由 APIHub 访问的企业内网网段，多个 CIDR 用逗号分隔；默认不放行任何私网地址。
# APIHUB_ALLOWED_PRIVATE_CIDRS=10.20.0.0/16,192.168.50.10/32
# APIHUB_CATALOG_DIR=../open-connector/catalog/apps

# 升级和初始化可使用独立 DDL 账号；运行进程不读取此变量。
# APIHUB_MIGRATION_DATABASE_URL=postgres://migrator:password@127.0.0.1/apihub?sslmode=require
APIHUB_ENCRYPTION_KEY_VERSION=1
# 轮换时保留旧版本 Base64 密钥，确认所有密文完成迁移后再移除。
# APIHUB_PREVIOUS_ENCRYPTION_KEYS='{"1":"old-base64-key"}'
